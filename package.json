{
  "name": "dsh-qa",
  "version": "0.1.3",
  "description": "dsh-qa QA Workbench: a local software testing workbench plugin for DeepSeek Harness. Project/iteration dual-mode, full-flow requirements / test cases / defects / milestones / reports, native QA preset, themes, kanban and calendar.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "qabench": "server/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "start": "node server/cli.js",
    "dev": "node --watch server/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "qa",
    "quality-assurance",
    "test",
    "workbench",
    "kanban",
    "测试",
    "质量",
    "工作台",
    "看板"
  ],
  "files": [
    "lib",
    "server",
    "public",
    "scripts",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naodeng/dsh-qa.git"
  },
  "homepage": "https://github.com/naodeng/dsh-qa#readme",
  "bugs": {
    "url": "https://github.com/naodeng/dsh-qa/issues"
  }
}
